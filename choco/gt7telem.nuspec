    <docsUrl>https://gt7trace.netlify.app</docsUrl>
    <bugTrackerUrl>https://github.com/ransh2014/gt7telemtrace/issues</bugTrackerUrl>
    <tags>gt7 gran-turismo telemetry racing sim-racing dashboard</tags>
    <summary>TRACE -- GT7 Telemetry Suite: live dashboard, lap analyst, and race analyst for Gran Turismo 7.</summary>
    <description>TRACE is a telemetry capture and analysis toolkit for Gran Turismo 7, reading the UDP stream from a PS4/PS5 over the local network. Includes a live dashboard, a 14-chart lap analyst, and a race analyst.</description>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
