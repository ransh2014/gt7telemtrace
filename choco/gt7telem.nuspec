<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>gt7telem</id>
    <version>__VERSION__</version>
    <packageSourceUrl>https://github.com/ransh2014/gt7telemtrace/tree/main/choco</packageSourceUrl>
    <owners>ransh2014</owners>
    <title>TRACE (GT7 Telemetry Suite)</title>
    <authors>ransh2014</authors>
    <projectUrl>https://gt7trace.netlify.app</projectUrl>
    <copyright>2026 ransh2014</copyright>
    <licenseUrl>https://github.com/ransh2014/gt7telemtrace/blob/main/LICENSE</licenseUrl>
